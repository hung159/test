generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id     Int     @id @default(autoincrement())
  name   String
  price  Int     // VND
  orders Order[]
}

model Order {
  id           Int      @id @default(autoincrement())
  customerName String
  phone        String
  quantity     Int
  total        Int
  productId    Int
  product      Product  @relation(fields: [productId], references: [id])
  createdAt    DateTime @default(now())
}
